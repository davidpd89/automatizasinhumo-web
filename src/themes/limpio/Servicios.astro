---
/**
 * STORE-OWNED. Catálogo del tema limpio (/servicios): una sola rejilla de tarjetas con
 * un filtro segmentado arriba, en vez de un panel por familia.
 *
 * Cada tarjeta lleva el color de su familia (data-familia="<id>" da --familia y
 * --familia-2, tokens.css): la cabecera visual, el icono, las viñetas y el precio lo leen.
 * Lo disponible va primero y con todo su peso; lo que viene después, en una banda aparte
 * y callada. Un servicio nuevo o una familia nueva no tocan este fichero: solo los datos.
 * El filtro es mejora progresiva: sin JavaScript se ve todo.
 */
import Icono from './IconoCat.astro';
import Boton from './ui/Boton.astro';
import Fondo from './ui/Fondo.astro';
import Pildora from './ui/Pildora.astro';
import Seccion from './ui/Seccion.astro';

interface Servicio {
  id: string;
  nombre: string;
  texto: string;
  icono: string;
  puntos: readonly string[];
  href?: string;
  /** Precio ya formateado («9 €»). */
  desde?: string;
  imagen?: string;
}
interface Familia {
  id: string;
  nombre: string;
  corto: string;
  texto: string;
  icono: string;
  servicios: readonly Servicio[];
}
interface Props {
  familias: readonly Familia[];
  proximas: readonly { id: string; nombre: string; icono: string }[];
}
const { familias, proximas } = Astro.props;

const todos = familias.flatMap((f) => f.servicios.map((s) => ({ ...s, familia: f })));
const listos = todos.flatMap((s) => (s.href ? [{ ...s, href: s.href }] : []));
const pronto = todos.filter((s) => !s.href);
const filtrables = familias.filter((f) => f.servicios.some((s) => s.href));
---

<Fondo />

<section class="cabeza" aria-labelledby="servicios-titulo">
  <p class="antetitulo">Servicios</p>
  <h1 id="servicios-titulo">Elige qué quieres <span class="marca">tener listo hoy</span></h1>
  <p class="subtitulo">Lo haces paso a paso, lo ves al momento y pagas solo cuando te guste.</p>
</section>

<div class="catalogo" data-catalogo>
  <div class="filtros" role="radiogroup" aria-label="Filtrar servicios" data-filtros>
    <label class="filtro">
      <input type="radio" name="familia" value="todo" checked />
      <span><Icono name="layout-dashboard" class="h-4 w-4" />Todo</span>
    </label>
    {filtrables.map((f) => (
      <label class="filtro" data-familia={f.id}>
        <input type="radio" name="familia" value={f.id} />
        <span><Icono name={f.icono} class="h-4 w-4" />{f.corto}</span>
      </label>
    ))}
  </div>

  <ul class="rejilla" aria-label="Servicios disponibles">
    {listos.map((s, i) => (
      <li class:list={['servicio', { principal: i === 0 && s.imagen }]} data-familia={s.familia.id} data-grupo={s.familia.id}>
        <span class="visual" aria-hidden="true">
          {s.imagen ? <img src={s.imagen} alt="" width="480" height="679" loading="eager" decoding="async" /> : <Icono name={s.icono} class="grande" />}
        </span>
        <div class="cuerpo">
          <p class="etiqueta-familia"><Icono name={s.icono} class="h-4 w-4" />{s.familia.corto}</p>
          <h2><a href={s.href} class="enlace">{s.nombre}</a></h2>
          <p class="texto">{s.texto}</p>
          <ul class="puntos">
            {s.puntos.map((p) => <li>{p}</li>)}
          </ul>
          <div class="pie">
            {s.desde && <p class="precio"><span>Desde</span> {s.desde}</p>}
            <Boton href={s.href} talla="compacta" class="ir">Empezar</Boton>
          </div>
        </div>
      </li>
    ))}
  </ul>

  <p class="vacio" data-vacio hidden>No hay servicios en esta categoría todavía.</p>

  {(pronto.length > 0 || proximas.length > 0) && (
    <Seccion id="despues" antetitulo="Próximamente" titulo="Lo que viene después" entradilla="Entra aquí con el mismo método: eliges, rellenas, lo ves y lo tienes." separada>
      <ul class="proximas" aria-label="Servicios en preparación">
        {pronto.map((s) => (
          <li data-familia={s.familia.id} data-grupo={s.familia.id}><Pildora icono={s.icono}>{s.nombre}</Pildora></li>
        ))}
        {proximas.map((p) => (
          <li data-familia={p.id} data-grupo="todo-solo"><Pildora icono={p.icono}>{p.nombre}</Pildora></li>
        ))}
      </ul>
    </Seccion>
  )}
</div>

<script>
  // Filtro segmentado: oculta lo que no es de la familia elegida. Sin JS, todo visible.
  const raiz = document.querySelector<HTMLElement>('[data-catalogo]');
  if (raiz) {
    const aplicar = (familia: string) => {
      let visibles = 0;
      raiz.querySelectorAll<HTMLElement>('.servicio').forEach((el) => {
        const ver = familia === 'todo' || el.dataset.grupo === familia;
        el.hidden = !ver;
        if (ver) visibles += 1;
      });
      raiz.querySelectorAll<HTMLElement>('.proximas li').forEach((el) => {
        el.hidden = familia !== 'todo' && el.dataset.grupo !== familia;
      });
      const vacio = raiz.querySelector<HTMLElement>('[data-vacio]');
      if (vacio) vacio.hidden = visibles > 0;
    };
    raiz.querySelector('[data-filtros]')?.addEventListener('change', (e) => {
      aplicar((e.target as HTMLInputElement).value);
    });
  }
</script>

<style>
  .cabeza {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(1rem, 4vh, 2.5rem) var(--ds-hueco-8);
    text-align: center;
  }
  .antetitulo {
    font-size: var(--ds-texto-etiqueta);
    font-weight: 600;
    letter-spacing: var(--ds-tracking-etiqueta);
    text-transform: uppercase;
    color: var(--color-faint);
  }
  h1 {
    max-width: 22ch;
    margin-top: var(--ds-hueco-3);
    color: var(--color-ink);
  }
  .marca {
    background: var(--ds-degradado-marca);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .subtitulo {
    max-width: 34rem;
    margin-top: var(--ds-hueco-4);
    font-size: var(--ds-texto-lead);
    line-height: 1.5;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* ── Filtro segmentado: una sola pieza, con el color de cada familia al elegirla. ── */
  .filtros {
    display: flex;
    gap: var(--ds-hueco-1);
    width: fit-content;
    max-width: 100%;
    margin: 0 auto var(--ds-hueco-8);
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--ds-radio-pildora);
    background: color-mix(in oklab, var(--color-surface) 85%, transparent);
    padding: var(--ds-hueco-1);
    box-shadow: var(--ds-sombra-1);
  }
  .filtro { position: relative; flex: none; cursor: pointer; }
  .filtro input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .filtro span {
    display: inline-flex;
    gap: var(--ds-hueco-2);
    align-items: center;
    min-height: var(--ds-toque);
    border-radius: var(--ds-radio-pildora);
    padding-inline: var(--ds-hueco-5);
    font-weight: 600;
    color: var(--color-muted);
    transition: background var(--ds-mov-rapido), color var(--ds-mov-rapido);
  }
  .filtro:hover span { color: var(--color-ink); }
  .filtro input:checked + span {
    /* Texto blanco: el degradado solo oscurece (de --familia a una mezcla con tinta) para llegar a 4,5:1. */
    background: linear-gradient(135deg in oklch, var(--familia), color-mix(in oklch, var(--familia) 70%, #000));
    color: #fff;
  }
  .filtro input:focus-visible + span { outline: 3px solid var(--familia); outline-offset: 2px; }

  /* ── Rejilla: una tarjeta por servicio, sin paneles dentro de paneles. ── */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--ds-hueco-6);
  }
  .servicio {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--ds-radio-tarjeta);
    background: var(--color-surface);
    box-shadow: var(--ds-sombra-1);
    transition:
      transform var(--ds-mov-normal) var(--ds-curva),
      box-shadow var(--ds-mov-normal);
  }
  .servicio[hidden] { display: none; }
  .servicio:hover,
  .servicio:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--ds-sombra-2);
  }
  /* El de la foto es el servicio de entrada: ocupa dos columnas cuando caben. */
  @media (min-width: 48rem) {
    .principal { grid-column: 1 / -1; flex-direction: row; }
    .principal .visual { flex: 0 0 44%; }
  }
  .visual {
    display: grid;
    place-items: center;
    min-height: 9rem;
    background: linear-gradient(160deg in oklch, color-mix(in oklab, var(--familia) 16%, #fff), color-mix(in oklab, var(--familia-2) 10%, #fff));
    padding: var(--ds-hueco-6);
  }
  .visual img {
    width: min(100%, 11rem);
    height: auto;
    border-radius: var(--ds-radio-sutil);
    box-shadow: var(--ds-sombra-2);
    transform: rotate(-2deg);
  }
  .visual :global(.grande) {
    width: 4rem;
    height: 4rem;
    color: var(--familia);
    opacity: 0.85;
  }
  .cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: var(--ds-hueco-6);
  }
  .etiqueta-familia {
    display: inline-flex;
    gap: var(--ds-hueco-2);
    align-items: center;
    font-size: var(--ds-texto-etiqueta);
    font-weight: 600;
    letter-spacing: var(--ds-tracking-etiqueta);
    text-transform: uppercase;
    color: var(--familia);
  }
  h2 {
    margin-top: var(--ds-hueco-2);
    font-family: var(--font-serif);
    font-size: var(--ds-texto-h3);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-ink);
  }
  /* Toda la tarjeta es clicable sin anidar enlaces: el ::after del título la cubre. */
  .enlace { color: inherit; text-decoration: none; }
  .enlace::after { position: absolute; inset: 0; content: ''; }
  .enlace:focus-visible { outline: none; }
  .servicio:has(.enlace:focus-visible) { outline: 3px solid var(--familia); outline-offset: 3px; }
  .texto {
    margin-top: var(--ds-hueco-2);
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .puntos {
    display: grid;
    gap: var(--ds-hueco-2);
    margin-top: var(--ds-hueco-4);
    font-size: var(--ds-texto-small);
    color: var(--color-ink);
  }
  .puntos li { position: relative; padding-left: var(--ds-hueco-5); }
  .puntos li::before {
    position: absolute;
    top: 0.45em;
    left: var(--ds-hueco-1);
    width: var(--ds-hueco-2);
    height: var(--ds-hueco-2);
    border-radius: var(--ds-radio-sutil);
    background: linear-gradient(135deg in oklch, var(--familia), var(--familia-2));
    transform: rotate(45deg);
    content: '';
  }
  .pie {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-hueco-3);
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--ds-hueco-6);
  }
  .precio {
    font-family: var(--font-serif);
    font-size: var(--ds-texto-h3);
    font-weight: 700;
    color: var(--familia);
  }
  .precio span {
    font-family: var(--font-sans);
    font-size: var(--ds-texto-small);
    font-weight: 500;
    color: var(--color-faint);
  }
  .pie :global(.ir) { position: relative; z-index: 1; }

  .vacio { padding-block: var(--ds-hueco-8); text-align: center; color: var(--color-muted); }
  .proximas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ds-hueco-2);
  }
  .proximas li[hidden] { display: none; }
  /* Píldora con el color de su familia. */
  .proximas :global(.pildora) {
    border-color: color-mix(in oklab, var(--familia) 30%, transparent);
    background: color-mix(in oklab, var(--familia) 9%, var(--color-surface));
    color: var(--familia);
  }

  @media (prefers-reduced-motion: reduce) {
    .servicio { transition: none; }
    .servicio:hover,
    .servicio:focus-within { transform: none; }
  }
</style>
